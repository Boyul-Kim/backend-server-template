# Copy to .env. Unset values fall back to safe defaults (see internal/config).
# Settings-backed values are applied on every start. TRUSTED_PROXY_HEADERS,
# SUPERUSER_IPS and RATE_LIMIT_EXCLUDED_IPS are cleared when unset. Other
# optional integrations (S3, backup schedule) keep the stored value when unset.
#
# In production, env-owned settings cannot be changed live from the dashboard.

# --- Runtime -----------------------------------------------------------------
# development | production. Production fail-closes the values marked [prod].
APP_ENV=development
HTTP_ADDR=127.0.0.1:8090
# PB_DATA_DIR=./pb_data
# [prod] Comma-separated absolute origins, no path. "*" is rejected.
# http:// is rejected unless ALLOW_INSECURE_HTTP=true.
CORS_ORIGINS=http://localhost:3000

# [prod] Exactly 32 characters, at least 8 distinct, not a repeated character.
# The value below is a documented example and is rejected in production.
# Generate a real one with: openssl rand -hex 16
# Keep it stable: losing it makes the stored settings unreadable.
# Docker/k8s: use PB_ENCRYPTION_KEY_FILE instead of putting the key here.
PB_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# [prod] Allows http:// APP_URL and CORS origins. Logs a warning.
# ALLOW_INSECURE_HTTP=false

# --- App ---------------------------------------------------------------------
APP_NAME=My API
# [prod] Public base URL (emails, OAuth2). Must be https:// unless
# ALLOW_INSECURE_HTTP=true.
APP_URL=http://localhost:8090

# Created on first start if no superuser exists (never updated afterwards).
# Password may also come from SUPERUSER_PASSWORD_FILE.
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change-me-please
# Applied on every boot and cleared when unset. CIDRs or single IPs.
# SUPERUSER_IPS=10.0.0.0/8
# Read so SMTP_DISABLED can require closed. Signup policy itself lands later.
# AUTH_SIGNUP=closed
# SMTP_DISABLED requires this to be false, with SUPERUSER_IPS set.
# MFA enrollment itself lands later.
# SUPERUSER_MFA=false

# --- Email (disabled when SMTP_HOST is empty) --------------------------------
# [prod] Required, unless SMTP_DISABLED=true with AUTH_SIGNUP=closed,
# SUPERUSER_MFA=false and SUPERUSER_IPS set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=
# Unset: implicit TLS (true) on port 465, off on 587 and everything else.
# On 587, false means STARTTLS is opportunistic. The server may upgrade the
# connection; if it does not, mail content can travel in clear. PocketBase
# still refuses to send the SMTP password without TLS unless the host is
# localhost.
SMTP_TLS=
SMTP_SENDER_NAME=Support
SMTP_SENDER_ADDRESS=
# SMTP_DISABLED=false

# --- File storage (local disk when S3_BUCKET is empty) -----------------------
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET=
# S3_SECRET_FILE=
S3_FORCE_PATH_STYLE=false

# --- Operations --------------------------------------------------------------
# Scheduled backups of pb_data, e.g. "0 3 * * *" (daily 03:00 UTC).
BACKUPS_CRON=
BACKUPS_MAX_KEEP=7
# BACKUPS_S3_SECRET=
# BACKUPS_S3_SECRET_FILE=
# [prod] Required. Header carrying the client IP behind a proxy, e.g.
# X-Forwarded-For or CF-Connecting-IP. Use "none" (any case, on its own)
# when nothing proxies the app; that clears any stored header and keeps
# leftmost-IP off. "false" is rejected, not treated as a header name.
TRUSTED_PROXY_HEADERS=
# IPs that skip rate limiting. Applied on every boot and cleared when unset.
# RATE_LIMIT_EXCLUDED_IPS=
# [prod] false is refused unless ALLOW_INSECURE_OVERRIDES=true.
# RATE_LIMIT_ENABLED=true
# HIDE_CONTROLS=true
# ALLOW_INSECURE_OVERRIDES=false
LOGS_MAX_DAYS=7
