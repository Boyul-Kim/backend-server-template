# Copy to .env. Unset values fall back to safe defaults (see internal/config).
# Settings-backed values (APP_*, SMTP_*, S3_*, ...) are applied on every start
# and override what was saved in the dashboard; unset ones are left alone.

# --- Runtime -----------------------------------------------------------------
# development | production. Production enables rate limiting, hides schema
# controls in the dashboard, disables automigrate and requires the values
# marked [prod] below.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8090
# PB_DATA_DIR=./pb_data
# [prod] Comma separated. "*" is rejected in production.
CORS_ORIGINS=http://localhost:3000

# [prod] Exactly 32 characters; encrypts the settings stored in the DB.
# Generate with: openssl rand -hex 16
# Keep it stable: losing it makes the stored settings unreadable.
PB_ENCRYPTION_KEY=

# --- App ---------------------------------------------------------------------
APP_NAME=My API
# [prod] Public base URL; used in emails and OAuth2 redirects.
APP_URL=http://localhost:8090

# Created on first start if no superuser exists (never updated afterwards).
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change-me-please

# --- Email (disabled when SMTP_HOST is empty) --------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SENDER_NAME=Support
SMTP_SENDER_ADDRESS=

# --- File storage (local disk when S3_BUCKET is empty) -----------------------
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET=
S3_FORCE_PATH_STYLE=false

# --- Operations --------------------------------------------------------------
# Scheduled backups of pb_data, e.g. "0 3 * * *" (daily 03:00 UTC).
BACKUPS_CRON=
BACKUPS_MAX_KEEP=7
# Behind a reverse proxy / load balancer, set the header carrying the client
# IP (used for rate limiting and logs), e.g. X-Forwarded-For or CF-Connecting-IP.
TRUSTED_PROXY_HEADERS=
# RATE_LIMIT_ENABLED=true
# HIDE_CONTROLS=true
LOGS_MAX_DAYS=7
